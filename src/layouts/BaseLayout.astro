---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SpCta from "../components/SpCta.astro";

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  ogType?: string;
  currentPage: "top" | "about" | "service" | "price" | "flow" | "faq" | "blog" | "other";
}
const { title, description, canonicalPath, ogImage, ogType = "website", currentPage } = Astro.props;
const siteUrl = (Astro.site?.toString() ?? "").replace(/\/$/, "");
const canonical = siteUrl + canonicalPath;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#D7141A" />
  <script>document.documentElement.classList.add("js")</script>
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="REALIFE BPO" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={siteUrl + ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <a class="skip-link" href="#main">本文へスキップ</a>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M21.5 2.5 2.8 10.1l7.4 3.1zM21.5 2.5l-10 11.7 3.3 7.3z" fill="currentColor"/></symbol>
    <symbol id="i-left" viewBox="0 0 24 24"><path d="M19 12H5m6-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-right" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-tel" viewBox="0 0 24 24"><path d="M6.6 3.5h3l1.5 4.2-2 1.3a12 12 0 0 0 5.9 5.9l1.3-2 4.2 1.5v3a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z" fill="currentColor"/></symbol>
    <symbol id="i-doc" viewBox="0 0 24 24"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><path d="M4 6h16v12H4zM4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  </svg>

  <SiteHeader currentPage={currentPage} />

  <slot />

<footer class="site-footer">
    <a class="footer-logo" href="/" aria-label="REALIFE BPO トップへ"><img src="/img/logo-realife-bpo.svg" alt="REALIFE BPO SERVICE" width="1151" height="244" loading="lazy" /></a>
    <p class="footer-company">合同会社REALIFE<br class="sp-only" /><span class="pc-only">　</span>〒812-0011 福岡県福岡市博多区博多駅前2-4-2 H¹O博多駅前707号室</p>
    <p class="footer-tel"><a href="tel:0926007592"><svg aria-hidden="true"><use href="#i-tel"/></svg>092-600-7592</a></p>
    <nav class="footer-nav" aria-label="フッターナビゲーション">
      <a href="/about/">REALIFEとは</a>
      <a href="/service/">サービス</a>
      <a href="/price/">料金</a>
      <a href="/flow/">導入の流れ</a>
      <a href="/faq/">よくある質問</a>
      <a href="/news/">お知らせ</a>
      <a href="/column/">コラム</a>
      <a href="/blog/">ブログ</a>
      <a href="/about/#company">会社概要</a>
      <a href="/?purpose=hearing#contact">30分無料相談</a>
      <!-- 資料請求: flags.SHOW_DOC -->
      <a href="/#contact">お問い合わせ</a>
      <a href="/privacy-policy/">プライバシーポリシー</a>
    </nav>
    <p class="copyright" lang="en">&copy; REALIFE. All Rights Reserved.</p>
  </footer>

<nav class="sp-cta" aria-label="お問い合わせの方法">
    <a class="is-sub" href="tel:0926007592"><svg aria-hidden="true"><use href="#i-tel"/></svg><span>電話</span></a>
    <a class="is-main" href="/?purpose=hearing#contact"><svg aria-hidden="true"><use href="#i-send"/></svg><span>30分無料相談</span></a>
  </nav>

  <script src="/main.js" is:inline></script>
</body>
</html>
