---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
---
<BaseLayout
  title="コラム｜REALIFE BPO"
  description="REALIFE BPOのコラム。BPOの活用、AI・DX、業種ごとの仕事の進め方をお伝えします。"
  canonicalPath="/column/"
  currentPage="other"
>
  <main id="main">
    <section class="page-head">
      <p class="label" lang="en">Column</p>
      <h1>コラム</h1>
      <p class="page-lead">BPOの活用、AI・DX、業種ごとの仕事の進め方などを、コラムとしてお伝えします。</p>
    </section>

    <section class="list-wrap">
      <p class="empty">コラムは準備中です。</p>
    </section>

    <CtaBanner />
  </main>
</BaseLayout>
